# DOCTOR COMPUTER ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env, fill in your values, then run:
#   flutter run --dart-define-from-file=.env

# Supabase Backend Configuration (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Supabase Storage S3 Endpoint & Bucket
SUPABASE_STORAGE_URL=https://YOUR_PROJECT_ID.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_BUCKET=assets

# Gemini API key is NOT stored here. Put it in the Supabase table
# `app_config` (key = GEMINI_API_KEY), see supabase/migrations/20261030_app_config.sql
