<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_POS_TOBE" targetNamespace="https://doctorcomputer.example/skpl/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:process id="Process_POS_Sale" name="Transaksi POS Kasir (TO-BE)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_POS_Sale">
      <bpmn:lane id="Lane_POS_Server" name="Supabase">
        <bpmn:flowNodeRef>Task_POS_CheckServerStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_POS_CreateRemoteOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_POS_App" name="Aplikasi POS dan Penyimpanan Lokal SQLite">
        <bpmn:flowNodeRef>Gateway_POS_Connectivity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_POS_ReadCachedStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_POS_StockAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_POS_SaveRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_POS_SaveSQLite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_POS_IssueReceiptOffline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_POS_OfflineQueued</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_POS_Cashier" name="Kasir">
        <bpmn:flowNodeRef>StartEvent_POS_Sale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_POS_EnterItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_POS_CorrectItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_POS_SelectPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_POS_IssueReceiptOnline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_POS_OnlineComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_POS_Sale" name="Kasir memulai transaksi pada shift aktif" />
    <bpmn:task id="Task_POS_EnterItems" name="Pilih produk dan masukkan jumlah" />
    <bpmn:exclusiveGateway id="Gateway_POS_Connectivity" name="Perangkat online?" />
    <bpmn:serviceTask id="Task_POS_CheckServerStock" name="Periksa stok terbaru di server" />
    <bpmn:task id="Task_POS_ReadCachedStock" name="Periksa stok lokal yang tersimpan di perangkat" />
    <bpmn:exclusiveGateway id="Gateway_POS_StockAvailable" name="Stok mencukupi?" />
    <bpmn:task id="Task_POS_CorrectItems" name="Ubah jumlah atau pilih produk lain" />
    <bpmn:task id="Task_POS_SelectPayment" name="Pilih tunai, QRIS atau debit BCA" />
    <bpmn:exclusiveGateway id="Gateway_POS_SaveRoute" name="Koneksi tersedia saat menyimpan?" />
    <bpmn:serviceTask id="Task_POS_CreateRemoteOrder" name="Buat order POS melalui RPC dan perbarui stok" />
    <bpmn:task id="Task_POS_SaveSQLite" name="Simpan transaksi lokal dengan ID idempotensi" />
    <bpmn:task id="Task_POS_IssueReceiptOnline" name="Terbitkan struk digital dan tampilkan transaksi berhasil" />
    <bpmn:task id="Task_POS_IssueReceiptOffline" name="Terbitkan struk lokal dan tandai menunggu sinkronisasi" />
    <bpmn:endEvent id="EndEvent_POS_OnlineComplete" name="Transaksi POS tersimpan di server" />
    <bpmn:endEvent id="EndEvent_POS_OfflineQueued" name="Transaksi tersimpan lokal, sinkronisasi tertunda" />
    <bpmn:sequenceFlow id="Flow_POS_Sale_01" sourceRef="StartEvent_POS_Sale" targetRef="Task_POS_EnterItems" />
    <bpmn:sequenceFlow id="Flow_POS_Sale_08" sourceRef="Task_POS_CorrectItems" targetRef="Task_POS_EnterItems" />
    <bpmn:sequenceFlow id="Flow_POS_Sale_02" sourceRef="Task_POS_EnterItems" targetRef="Gateway_POS_Connectivity" />
    <bpmn:sequenceFlow id="Flow_POS_Sale_03" name="Ya" sourceRef="Gateway_POS_Connectivity" targetRef="Task_POS_CheckServerStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Koneksi tersedia</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_POS_Sale_04" name="Tidak" sourceRef="Gateway_POS_Connectivity" targetRef="Task_POS_ReadCachedStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Perangkat offline</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_POS_Sale_05" sourceRef="Task_POS_CheckServerStock" targetRef="Gateway_POS_StockAvailable" />
    <bpmn:sequenceFlow id="Flow_POS_Sale_06" sourceRef="Task_POS_ReadCachedStock" targetRef="Gateway_POS_StockAvailable" />
    <bpmn:sequenceFlow id="Flow_POS_Sale_07" name="Tidak" sourceRef="Gateway_POS_StockAvailable" targetRef="Task_POS_CorrectItems">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Stok tidak mencukupi</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_POS_Sale_09" name="Ya" sourceRef="Gateway_POS_StockAvailable" targetRef="Task_POS_SelectPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Stok mencukupi</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_POS_Sale_10" sourceRef="Task_POS_SelectPayment" targetRef="Gateway_POS_SaveRoute" />
    <bpmn:sequenceFlow id="Flow_POS_Sale_11" name="Ya" sourceRef="Gateway_POS_SaveRoute" targetRef="Task_POS_CreateRemoteOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Koneksi tersedia saat transaksi disimpan</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_POS_Sale_12" name="Tidak" sourceRef="Gateway_POS_SaveRoute" targetRef="Task_POS_SaveSQLite">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Koneksi terputus atau offline</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_POS_Sale_13" sourceRef="Task_POS_CreateRemoteOrder" targetRef="Task_POS_IssueReceiptOnline" />
    <bpmn:sequenceFlow id="Flow_POS_Sale_15" sourceRef="Task_POS_SaveSQLite" targetRef="Task_POS_IssueReceiptOffline" />
    <bpmn:sequenceFlow id="Flow_POS_Sale_14" sourceRef="Task_POS_IssueReceiptOnline" targetRef="EndEvent_POS_OnlineComplete" />
    <bpmn:sequenceFlow id="Flow_POS_Sale_16" sourceRef="Task_POS_IssueReceiptOffline" targetRef="EndEvent_POS_OfflineQueued" />
  </bpmn:process>
  <bpmn:process id="Process_POS_Sync" name="Sinkronisasi Transaksi POS Offline (TO-BE)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_POS_Sync">
      <bpmn:lane id="Lane_Sync_Server" name="Supabase">
        <bpmn:flowNodeRef>Task_POS_IdempotentSync</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_POS_SaveMapping</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sync_App" name="Aplikasi dan SQLite lokal">
        <bpmn:flowNodeRef>StartEvent_POS_ConnectionRestored</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_POS_LoadPending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_POS_MarkSynced</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_POS_Synced</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_POS_ConnectionRestored" name="Koneksi internet kembali tersedia" />
    <bpmn:task id="Task_POS_LoadPending" name="Ambil antrean transaksi offline dari SQLite" />
    <bpmn:serviceTask id="Task_POS_IdempotentSync" name="Kirim transaksi melalui RPC sinkronisasi idempoten" />
    <bpmn:serviceTask id="Task_POS_SaveMapping" name="Simpan pemetaan ID lokal ke order server" />
    <bpmn:task id="Task_POS_MarkSynced" name="Tandai transaksi lokal sudah tersinkron" />
    <bpmn:endEvent id="EndEvent_POS_Synced" name="Antrean POS offline tersinkron" />
    <bpmn:sequenceFlow id="Flow_POS_Sync_01" sourceRef="StartEvent_POS_ConnectionRestored" targetRef="Task_POS_LoadPending" />
    <bpmn:sequenceFlow id="Flow_POS_Sync_02" sourceRef="Task_POS_LoadPending" targetRef="Task_POS_IdempotentSync" />
    <bpmn:sequenceFlow id="Flow_POS_Sync_03" sourceRef="Task_POS_IdempotentSync" targetRef="Task_POS_SaveMapping" />
    <bpmn:sequenceFlow id="Flow_POS_Sync_04" sourceRef="Task_POS_SaveMapping" targetRef="Task_POS_MarkSynced" />
    <bpmn:sequenceFlow id="Flow_POS_Sync_05" sourceRef="Task_POS_MarkSynced" targetRef="EndEvent_POS_Synced" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_POS_TOBE" name="Transaksi POS dan sinkronisasi offline">
    <bpmn:participant id="Participant_POS_Sale" name="Transaksi POS Kasir" processRef="Process_POS_Sale" />
    <bpmn:participant id="Participant_POS_Sync" name="Sinkronisasi POS Offline" processRef="Process_POS_Sync" />
  </bpmn:collaboration>
