<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_TOBE"
                  targetNamespace="https://doctorcomputer.example/skpl/bpmn">
  <bpmn:process id="Process_TOBE" name="Proses Bisnis TO-BE Doctor Computer" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TOBE">
      <bpmn:lane id="Lane_Customer_TOBE" name="Pelanggan">
        <bpmn:flowNodeRef>StartEvent_TOBE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Browse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Checkout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckoutError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RetryCheckout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CheckoutCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayOutsideApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackAndReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_TOBE</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System_TOBE" name="Aplikasi Flutter dan Backend Supabase">
        <bpmn:flowNodeRef>Task_ValidateCheckout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckoutValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreShippedNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendShippedPush</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ShippedPushResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InAppFallbackShipped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwardPointsAndStoreNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDeliveredPush</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DeliveredPushResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InAppFallbackDelivered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Staff_TOBE" name="Admin / Kasir">
        <bpmn:flowNodeRef>Task_PrepareOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyExternalPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateShipped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateDelivered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Courier_TOBE" name="Kurir (di luar aplikasi)">
        <bpmn:flowNodeRef>Task_CourierDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmCourierDelivery</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_TOBE" name="Pelanggan mulai berbelanja"/>
    <bpmn:task id="Task_Browse" name="Login, telusuri katalog dan pilih produk / rakit PC"/>
    <bpmn:task id="Task_Checkout" name="Isi checkout, alamat, kurir dan voucher; metode pembayaran dicatat"/>
    <bpmn:serviceTask id="Task_ValidateCheckout" name="Validasi harga, stok dan voucher di server"/>
    <bpmn:exclusiveGateway id="Gateway_CheckoutValid" name="Checkout valid?"/>
    <bpmn:task id="Task_CheckoutError" name="Tampilkan alasan gagal dan minta koreksi"/>
    <bpmn:exclusiveGateway id="Gateway_RetryCheckout" name="Coba checkout lagi?"/>
    <bpmn:endEvent id="EndEvent_CheckoutCancelled" name="Pelanggan membatalkan checkout"/>
    <bpmn:serviceTask id="Task_CreateOrder" name="Buat order dan item secara atomik"/>
    <bpmn:task id="Task_OrderConfirmation" name="Terima konfirmasi nomor pesanan"/>
    <bpmn:task id="Task_PayOutsideApp" name="Lakukan pembayaran sesuai metode yang dipilih di luar aplikasi"/>
    <bpmn:task id="Task_VerifyExternalPayment" name="Admin / kasir memverifikasi pembayaran di luar aplikasi"/>
    <bpmn:task id="Task_PrepareOrder" name="Periksa pesanan, siapkan barang dan kemas"/>
    <bpmn:task id="Task_UpdateShipped" name="Masukkan resi dan ubah status menjadi shipped"/>
    <bpmn:serviceTask id="Task_StoreShippedNotification" name="Trigger menyimpan user_notifications"/>
    <bpmn:serviceTask id="Task_SendShippedPush" name="Webhook dan Edge Function mengirim push via FCM"/>
    <bpmn:exclusiveGateway id="Gateway_ShippedPushResult" name="Push terkirim?"/>
    <bpmn:task id="Task_InAppFallbackShipped" name="Push gagal; notifikasi status tetap tersedia di aplikasi"/>
    <bpmn:task id="Task_CourierDelivery" name="Kurir mengirim paket kepada pelanggan"/>
    <bpmn:task id="Task_ConfirmCourierDelivery" name="Kurir mengonfirmasi hasil pengantaran kepada toko"/>
    <bpmn:task id="Task_UpdateDelivered" name="Admin / kasir mengubah status menjadi delivered"/>
    <bpmn:serviceTask id="Task_AwardPointsAndStoreNotification" name="Server memberi poin dan menyimpan notifikasi status"/>
    <bpmn:serviceTask id="Task_SendDeliveredPush" name="Webhook dan Edge Function mengirim push via FCM"/>
    <bpmn:exclusiveGateway id="Gateway_DeliveredPushResult" name="Push terkirim?"/>
    <bpmn:task id="Task_InAppFallbackDelivered" name="Push gagal; pelanggan tetap dapat melihat notifikasi di aplikasi"/>
    <bpmn:task id="Task_TrackAndReview" name="Pantau status / resi; setelah delivered pelanggan dapat memberi ulasan"/>
    <bpmn:endEvent id="EndEvent_TOBE" name="Proses pesanan selesai"/>

    <bpmn:sequenceFlow id="Flow_TOBE_01" sourceRef="StartEvent_TOBE" targetRef="Task_Browse"/>
    <bpmn:sequenceFlow id="Flow_TOBE_02" sourceRef="Task_Browse" targetRef="Task_Checkout"/>
    <bpmn:sequenceFlow id="Flow_TOBE_03" sourceRef="Task_Checkout" targetRef="Task_ValidateCheckout"/>
    <bpmn:sequenceFlow id="Flow_TOBE_04" sourceRef="Task_ValidateCheckout" targetRef="Gateway_CheckoutValid"/>
    <bpmn:sequenceFlow id="Flow_TOBE_05" name="Tidak" sourceRef="Gateway_CheckoutValid" targetRef="Task_CheckoutError">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Data checkout tidak valid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TOBE_06" sourceRef="Task_CheckoutError" targetRef="Gateway_RetryCheckout"/>
    <bpmn:sequenceFlow id="Flow_TOBE_07" name="Ya" sourceRef="Gateway_CheckoutValid" targetRef="Task_CreateOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Data checkout valid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TOBE_08" sourceRef="Task_CreateOrder" targetRef="Task_OrderConfirmation"/>
    <bpmn:sequenceFlow id="Flow_TOBE_09" sourceRef="Task_OrderConfirmation" targetRef="Task_PayOutsideApp"/>
    <bpmn:sequenceFlow id="Flow_TOBE_10" sourceRef="Task_PayOutsideApp" targetRef="Task_VerifyExternalPayment"/>
    <bpmn:sequenceFlow id="Flow_TOBE_11" sourceRef="Task_VerifyExternalPayment" targetRef="Task_PrepareOrder"/>
    <bpmn:sequenceFlow id="Flow_TOBE_12" sourceRef="Task_PrepareOrder" targetRef="Task_UpdateShipped"/>
    <bpmn:sequenceFlow id="Flow_TOBE_13" sourceRef="Task_UpdateShipped" targetRef="Task_StoreShippedNotification"/>
    <bpmn:sequenceFlow id="Flow_TOBE_14" sourceRef="Task_StoreShippedNotification" targetRef="Task_SendShippedPush"/>
    <bpmn:sequenceFlow id="Flow_TOBE_15" sourceRef="Task_SendShippedPush" targetRef="Gateway_ShippedPushResult"/>
    <bpmn:sequenceFlow id="Flow_TOBE_16" name="Terkirim" sourceRef="Gateway_ShippedPushResult" targetRef="Task_CourierDelivery">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">FCM mengonfirmasi pengiriman</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TOBE_17" name="Gagal" sourceRef="Gateway_ShippedPushResult" targetRef="Task_InAppFallbackShipped">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">FCM gagal atau token tidak tersedia</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TOBE_18" sourceRef="Task_InAppFallbackShipped" targetRef="Task_CourierDelivery"/>
    <bpmn:sequenceFlow id="Flow_TOBE_19" sourceRef="Task_CourierDelivery" targetRef="Task_ConfirmCourierDelivery"/>
    <bpmn:sequenceFlow id="Flow_TOBE_20" sourceRef="Task_ConfirmCourierDelivery" targetRef="Task_UpdateDelivered"/>
    <bpmn:sequenceFlow id="Flow_TOBE_21" sourceRef="Task_UpdateDelivered" targetRef="Task_AwardPointsAndStoreNotification"/>
    <bpmn:sequenceFlow id="Flow_TOBE_22" sourceRef="Task_AwardPointsAndStoreNotification" targetRef="Task_SendDeliveredPush"/>
    <bpmn:sequenceFlow id="Flow_TOBE_23" sourceRef="Task_SendDeliveredPush" targetRef="Gateway_DeliveredPushResult"/>
    <bpmn:sequenceFlow id="Flow_TOBE_24" name="Terkirim" sourceRef="Gateway_DeliveredPushResult" targetRef="Task_TrackAndReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">FCM mengonfirmasi pengiriman</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TOBE_25" name="Gagal" sourceRef="Gateway_DeliveredPushResult" targetRef="Task_InAppFallbackDelivered">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">FCM gagal atau token tidak tersedia</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TOBE_26" sourceRef="Task_InAppFallbackDelivered" targetRef="Task_TrackAndReview"/>
    <bpmn:sequenceFlow id="Flow_TOBE_27" sourceRef="Task_TrackAndReview" targetRef="EndEvent_TOBE"/>
    <bpmn:sequenceFlow id="Flow_TOBE_28" name="Ya" sourceRef="Gateway_RetryCheckout" targetRef="Task_Checkout">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Pelanggan memperbaiki data dan mencoba lagi</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TOBE_29" name="Tidak" sourceRef="Gateway_RetryCheckout" targetRef="EndEvent_CheckoutCancelled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Pelanggan membatalkan checkout</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <bpmn:process id="Process_Admin_TOBE" name="Pengelolaan Admin (TO-BE)" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Admin_TOBE" name="Admin membuka dashboard"/>
    <bpmn:task id="Task_ManageCatalog_TOBE" name="Kelola produk, stok dan flash sale"/>
    <bpmn:task id="Task_ManagePromotions_TOBE" name="Atur promosi dan voucher"/>
    <bpmn:task id="Task_ManageUsersVouchers_TOBE" name="Kelola pengguna dan akun staf"/>
    <bpmn:task id="Task_ManageReviews_TOBE" name="Tinjau dan balas ulasan pelanggan"/>
    <bpmn:task id="Task_ViewReports_TOBE" name="Lihat statistik penjualan online dan POS"/>
    <bpmn:endEvent id="EndEvent_Admin_TOBE" name="Perubahan dan laporan tersimpan"/>

    <bpmn:sequenceFlow id="Flow_Admin_TOBE_01" sourceRef="StartEvent_Admin_TOBE" targetRef="Task_ManageCatalog_TOBE"/>
    <bpmn:sequenceFlow id="Flow_Admin_TOBE_02" sourceRef="Task_ManageCatalog_TOBE" targetRef="Task_ManagePromotions_TOBE"/>
    <bpmn:sequenceFlow id="Flow_Admin_TOBE_03" sourceRef="Task_ManagePromotions_TOBE" targetRef="Task_ManageUsersVouchers_TOBE"/>
    <bpmn:sequenceFlow id="Flow_Admin_TOBE_04" sourceRef="Task_ManageUsersVouchers_TOBE" targetRef="Task_ManageReviews_TOBE"/>
    <bpmn:sequenceFlow id="Flow_Admin_TOBE_05" sourceRef="Task_ManageReviews_TOBE" targetRef="Task_ViewReports_TOBE"/>
    <bpmn:sequenceFlow id="Flow_Admin_TOBE_06" sourceRef="Task_ViewReports_TOBE" targetRef="EndEvent_Admin_TOBE"/>
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_TOBE" name="Proses Bisnis TO-BE">
    <bpmn:participant id="Participant_Store_TOBE" name="Pelanggan dan Sistem Doctor Computer" processRef="Process_TOBE"/>
    <bpmn:participant id="Participant_Admin_TOBE" name="Admin Doctor Computer" processRef="Process_Admin_TOBE"/>
  </bpmn:collaboration>

  <bpmndi:BPMNDiagram id="Diagram_TOBE">
    <bpmndi:BPMNPlane id="Plane_TOBE" bpmnElement="Collaboration_TOBE">
      <bpmndi:BPMNShape id="Shape_Participant_Store_TOBE" bpmnElement="Participant_Store_TOBE" isHorizontal="true">
        <dc:Bounds x="100" y="100" width="4900" height="520"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_Admin_TOBE" bpmnElement="Participant_Admin_TOBE" isHorizontal="true">
        <dc:Bounds x="100" y="680" width="4900" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Customer_TOBE" bpmnElement="Lane_Customer_TOBE" isHorizontal="true">
        <dc:Bounds x="100" y="100" width="4900" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_System_TOBE" bpmnElement="Lane_System_TOBE" isHorizontal="true">
        <dc:Bounds x="100" y="230" width="4900" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Staff_TOBE" bpmnElement="Lane_Staff_TOBE" isHorizontal="true">
        <dc:Bounds x="100" y="360" width="4900" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Courier_TOBE" bpmnElement="Lane_Courier_TOBE" isHorizontal="true">
        <dc:Bounds x="100" y="490" width="4900" height="130"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Start_TOBE" bpmnElement="StartEvent_TOBE">
        <dc:Bounds x="150" y="147" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Browse" bpmnElement="Task_Browse">
        <dc:Bounds x="220" y="120" width="175" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Checkout" bpmnElement="Task_Checkout">
        <dc:Bounds x="420" y="125" width="175" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ValidateCheckout" bpmnElement="Task_ValidateCheckout">
        <dc:Bounds x="640" y="260" width="175" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_CheckoutValid" bpmnElement="Gateway_CheckoutValid" isMarkerVisible="true">
        <dc:Bounds x="850" y="270" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CheckoutError" bpmnElement="Task_CheckoutError">
        <dc:Bounds x="950" y="130" width="175" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_RetryCheckout" bpmnElement="Gateway_RetryCheckout" isMarkerVisible="true">
        <dc:Bounds x="780" y="140" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_CheckoutCancelled" bpmnElement="EndEvent_CheckoutCancelled">
        <dc:Bounds x="850" y="147" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CreateOrder" bpmnElement="Task_CreateOrder">
        <dc:Bounds x="950" y="260" width="175" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_OrderConfirmation" bpmnElement="Task_OrderConfirmation">
        <dc:Bounds x="1170" y="130" width="175" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PayOutsideApp" bpmnElement="Task_PayOutsideApp">
        <dc:Bounds x="1390" y="120" width="190" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_VerifyExternalPayment" bpmnElement="Task_VerifyExternalPayment">
        <dc:Bounds x="1620" y="390" width="190" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PrepareOrder" bpmnElement="Task_PrepareOrder">
        <dc:Bounds x="1850" y="390" width="190" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UpdateShipped" bpmnElement="Task_UpdateShipped">
        <dc:Bounds x="2080" y="385" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StoreShippedNotification" bpmnElement="Task_StoreShippedNotification">
        <dc:Bounds x="2310" y="260" width="190" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SendShippedPush" bpmnElement="Task_SendShippedPush">
        <dc:Bounds x="2540" y="250" width="190" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_ShippedPushResult" bpmnElement="Gateway_ShippedPushResult" isMarkerVisible="true">
        <dc:Bounds x="2770" y="270" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_InAppFallbackShipped" bpmnElement="Task_InAppFallbackShipped">
        <dc:Bounds x="2890" y="250" width="190" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CourierDelivery" bpmnElement="Task_CourierDelivery">
        <dc:Bounds x="3120" y="510" width="190" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ConfirmCourierDelivery" bpmnElement="Task_ConfirmCourierDelivery">
        <dc:Bounds x="3350" y="510" width="190" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UpdateDelivered" bpmnElement="Task_UpdateDelivered">
        <dc:Bounds x="3580" y="390" width="190" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AwardPointsAndStoreNotification" bpmnElement="Task_AwardPointsAndStoreNotification">
        <dc:Bounds x="3810" y="250" width="190" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SendDeliveredPush" bpmnElement="Task_SendDeliveredPush">
        <dc:Bounds x="4040" y="250" width="190" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_DeliveredPushResult" bpmnElement="Gateway_DeliveredPushResult" isMarkerVisible="true">
        <dc:Bounds x="4270" y="270" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_InAppFallbackDelivered" bpmnElement="Task_InAppFallbackDelivered">
        <dc:Bounds x="4390" y="250" width="190" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_TrackAndReview" bpmnElement="Task_TrackAndReview">
        <dc:Bounds x="4620" y="120" width="190" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_TOBE" bpmnElement="EndEvent_TOBE">
        <dc:Bounds x="4850" y="147" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Admin_TOBE" bpmnElement="StartEvent_Admin_TOBE">
        <dc:Bounds x="150" y="727" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ManageCatalog_TOBE" bpmnElement="Task_ManageCatalog_TOBE">
        <dc:Bounds x="240" y="710" width="225" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ManagePromotions_TOBE" bpmnElement="Task_ManagePromotions_TOBE">
        <dc:Bounds x="520" y="710" width="230" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ManageUsersVouchers_TOBE" bpmnElement="Task_ManageUsersVouchers_TOBE">
        <dc:Bounds x="810" y="710" width="250" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ManageReviews_TOBE" bpmnElement="Task_ManageReviews_TOBE">
        <dc:Bounds x="1120" y="710" width="250" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ViewReports_TOBE" bpmnElement="Task_ViewReports_TOBE">
        <dc:Bounds x="1430" y="710" width="250" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Admin_TOBE" bpmnElement="EndEvent_Admin_TOBE">
        <dc:Bounds x="1740" y="727" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_TOBE_01" bpmnElement="Flow_TOBE_01">
        <di:waypoint x="186" y="165"/><di:waypoint x="220" y="165"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_TOBE_02" bpmnElement="Flow_TOBE_02">
        <di:waypoint x="395" y="165"/><di:waypoint x="420" y="165"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_TOBE_03" bpmnElement="Flow_TOBE_03">
        <di:waypoint x="595" y="165"/><di:waypoint x="615" y="165"/><di:waypoint x="615" y="295"/><di:waypoint x="640" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_TOBE_04" bpmnElement="Flow_TOBE_04">
        <di:waypoint x="815" y="295"/><di:waypoint x="850" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_TOBE_05" bpmnElement="Flow_TOBE_05">
        <di:waypoint x="900" y="295"/><di:waypoint x="925" y="295"/><di:waypoint x="925" y="165"/><di:waypoint x="950" y="165"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_TOBE_06" bpmnElement="Flow_TOBE_06">
        <di:waypoint x="1125" y="165"/><di:waypoint x="1140" y="165"/><di:waypoint x="1140" y="110"/><di:waypoint x="805" y="110"/><di:waypoint x="805" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_TOBE_07" bpmnElement="Flow_TOBE_07">
        <di:waypoint x="900" y="295"/><di:waypoint x="950" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_TOBE_08" bpmnElement="Flow_TOBE_08">
        <di:waypoint x="1125" y="295"/><di:waypoint x="1147" y="295"/><di:waypoint x="1147" y="165"/><di:waypoint x="1170" y="165"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_TOBE_09" bpmnElement="Flow_TOBE_09">
        <di:waypoint x="1345" y="165"/><di:waypoint x="1390" y="165"/>
